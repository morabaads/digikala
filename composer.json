{
    "name": "morabaads/dk-bridge",
    "description": "WooCommerce to Digikala Seller Center bridge (WordPress plugin).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "php-stubs/woocommerce-stubs": "^9.1",
        "php-stubs/wordpress-stubs": "^6.6",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload-dev": {
        "psr-4": {
            "DKBridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "analyse": "phpstan analyse --memory-limit=2G"
    },
    "config": {
        "sort-packages": true
    }
}
